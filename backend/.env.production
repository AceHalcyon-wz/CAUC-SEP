# ==================== CAUC-SEP 生产环境配置 ====================
# 
# 文件名: .env.production
# 路径: backend/.env.production
# 功能: 生产环境专用配置
# 版本: v1.0
# 创建日期: 2026-03-25
# 作者: DevOps Engineer Agent
#
# 使用说明:
# 1. 此文件为生产环境模板，实际部署时需要修改敏感配置
# 2. 敏感信息必须通过环境变量或密钥管理系统注入
# 3. 不要将此文件提交到版本控制系统（已在.gitignore中配置）
#
# 安全约束:
# - JWT密钥必须使用安全的随机值
# - 所有SIMULATION必须为false
# - DEBUG必须为false
# - LOG_LEVEL建议WARNING或ERROR
# ============================================================================

# ==================== 应用配置 ====================

# 应用名称
APP_NAME=CAUC-SEP

# 应用版本（构建时自动注入）
APP_VERSION=4.0.0

# 运行环境
APP_ENV=production

# 调试模式（生产环境必须为false）
DEBUG=false

# 服务器地址（0.0.0.0 允许外部访问）
HOST=0.0.0.0

# 服务器端口
PORT=8000

# ==================== 数据库配置 ====================

# 数据库URL（生产环境建议使用绝对路径）
DATABASE_URL=sqlite:///./data/experiments.db

# 数据库连接池大小
DATABASE_POOL_SIZE=10

# 数据库最大溢出连接数
DATABASE_MAX_OVERFLOW=20

# 是否打印SQL语句（生产环境必须为false）
DATABASE_ECHO=false

# ==================== Redis 配置 ====================

# Redis主机地址
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis数据库索引
REDIS_DB=0

# Redis密码（必须设置！）
# 使用环境变量: REDIS_PASSWORD
REDIS_PASSWORD=${REDIS_PASSWORD}

# Redis最大连接数
REDIS_MAX_CONNECTIONS=20

# Redis Socket超时时间（秒）
REDIS_SOCKET_TIMEOUT=10

# Redis连接超时时间（秒）
REDIS_SOCKET_CONNECT_TIMEOUT=10

# ==================== 设备配置 - 步进电机 ====================

# 设备ID
MOTOR_DEVICE_ID=stepper_01

# 串口号（根据实际连接修改）
MOTOR_PORT=COM3

# Modbus从站ID
MOTOR_SLAVE_ID=1

# 波特率
MOTOR_BAUDRATE=115200

# 校验位
MOTOR_PARITY=N

# 停止位
MOTOR_STOPBITS=1

# 数据位
MOTOR_BYTESIZE=8

# 通信超时时间（秒）
MOTOR_TIMEOUT=1.0

# 每毫米步数
MOTOR_STEPS_PER_MM=1600

# 正向软件限位（毫米）
MOTOR_POSITIVE_LIMIT=50.0

# 负向软件限位（毫米）
MOTOR_NEGATIVE_LIMIT=-50.0

# 是否启用仿真模式（生产环境必须为false）
MOTOR_SIMULATION=false

# 步进电机参数范围约束
MOTOR_SPEED_MIN=100
MOTOR_SPEED_MAX=5000
MOTOR_SPEED_DEFAULT=500
MOTOR_ACCELERATION_MIN=10
MOTOR_ACCELERATION_MAX=10000
MOTOR_ACCELERATION_DEFAULT=100
MOTOR_POSITION_MIN=-1000000
MOTOR_POSITION_MAX=1000000

# ==================== 设备配置 - 电磁铁 ====================

# 设备ID
ELECTROMAGNET_DEVICE_ID=electromagnet_01

# 串口号
ELECTROMAGNET_PORT=COM4

# 波特率
ELECTROMAGNET_BAUDRATE=9600

# 校验位
ELECTROMAGNET_PARITY=N

# 停止位
ELECTROMAGNET_STOPBITS=1

# 数据位
ELECTROMAGNET_BYTESIZE=8

# 通信超时时间（秒）
ELECTROMAGNET_TIMEOUT=1.0

# 最大电流（安培）
ELECTROMAGNET_MAX_CURRENT=10.0

# 是否启用仿真模式（生产环境必须为false）
ELECTROMAGNET_SIMULATION=false

# 电磁铁参数范围约束
ELECTROMAGNET_CURRENT_MIN=0.0
ELECTROMAGNET_CURRENT_MAX=10.0
ELECTROMAGNET_CURRENT_DEFAULT=5.0

# ==================== 设备配置 - 温控器 ====================

# 设备ID
TEMPERATURE_DEVICE_ID=temp_controller_01

# 串口号
TEMPERATURE_PORT=COM5

# 波特率
TEMPERATURE_BAUDRATE=9600

# Modbus从站ID
TEMPERATURE_SLAVE_ID=1

# 是否启用仿真模式（生产环境必须为false）
TEMPERATURE_SIMULATION=false

# PID参数
TEMPERATURE_PID_KP=1.0
TEMPERATURE_PID_KI=0.1
TEMPERATURE_PID_KD=0.01

# 温度范围（摄氏度）
TEMPERATURE_MAX_TEMP=400.0
TEMPERATURE_MIN_TEMP=-50.0

# 温控器参数范围约束
TEMPERATURE_TARGET_MIN=-50.0
TEMPERATURE_TARGET_MAX=400.0
TEMPERATURE_TOLERANCE=0.5

# ==================== 设备配置 - 压电控制器 ====================

# 设备ID
PIEZO_DEVICE_ID=piezo_01

# 串口号
PIEZO_PORT=COM6

# 是否启用仿真模式（生产环境必须为false）
PIEZO_SIMULATION=false

# 最大电压（伏特）
PIEZO_MAX_VOLTAGE=150.0

# 最大位移（微米）
PIEZO_MAX_DISPLACEMENT=100.0

# 通道数
PIEZO_CHANNELS=3

# 压电控制器参数范围约束
PIEZO_VOLTAGE_MIN=0.0
PIEZO_VOLTAGE_MAX=150.0
PIEZO_VOLTAGE_DEFAULT=0.0

# ==================== 设备配置 - 皮安表 ====================

# 设备ID
AMMETER_DEVICE_ID=picoammeter_01

# 串口号
AMMETER_PORT=COM7

# 是否启用仿真模式（生产环境必须为false）
AMMETER_SIMULATION=false

# 采样率（Hz）
AMMETER_SAMPLE_RATE=100.0

# 电流量程
AMMETER_CURRENT_RANGE=auto

# 皮安表参数范围约束
AMMETER_CURRENT_MIN=-1e-6
AMMETER_CURRENT_MAX=1e-6

# ==================== 安全配置 ====================

# JWT密钥（必须通过环境变量设置！）
# 生成方法: openssl rand -hex 32
# 不要在此文件中硬编码密钥！
JWT_SECRET_KEY=${JWT_SECRET_KEY}

# JWT算法
JWT_ALGORITHM=HS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 密码是否需要大写字母
PASSWORD_REQUIRE_UPPERCASE=true

# 密码是否需要小写字母
PASSWORD_REQUIRE_LOWERCASE=true

# 密码是否需要数字
PASSWORD_REQUIRE_DIGIT=true

# 密码是否需要特殊字符
PASSWORD_REQUIRE_SPECIAL=false

# ==================== CORS 配置 ====================

# 允许的源（生产环境必须限制为实际域名）
# 多个源用逗号分隔
CORS_ALLOW_ORIGINS=https://your-domain.com,https://app.your-domain.com

# 是否允许携带凭证
CORS_ALLOW_CREDENTIALS=true

# 允许的方法
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# 允许的请求头
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# ==================== 日志配置 ====================

# 日志级别（生产环境建议WARNING或ERROR）
LOG_LEVEL=WARNING

# 日志目录
LOG_DIR=logs

# 日志文件最大大小（字节）
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=10

# 是否压缩日志文件
LOG_COMPRESS=true

# 是否使用JSON格式（生产环境建议true）
LOG_JSON_FORMAT=true

# 是否包含时间戳
LOG_INCLUDE_TIMESTAMP=true

# 是否包含调用者信息
LOG_INCLUDE_CALLER=false

# ==================== 缓存配置 ====================

# 默认缓存过期时间（秒）
CACHE_DEFAULT_TTL=300

# 内存缓存最大条目数
CACHE_MAX_MEMORY_ITEMS=1000

# 缓存键前缀
CACHE_KEY_PREFIX=cauc_sep:prod:

# ==================== WebSocket 配置 ====================

# WebSocket心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30

# WebSocket最大连接数
WS_MAX_CONNECTIONS=100

# WebSocket消息队列大小
WS_MESSAGE_QUEUE_SIZE=1000

# ==================== 实验配置 ====================

# 最大并发实验数
EXPERIMENT_MAX_CONCURRENT=5

# 实验数据批量大小
EXPERIMENT_DATA_BATCH_SIZE=1000

# 实验自动保存间隔（秒）
EXPERIMENT_AUTO_SAVE_INTERVAL=60
