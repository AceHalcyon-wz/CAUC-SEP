# ==================== CAUC-SEP 环境配置示例 ====================
# 
# 文件名: .env.example
# 路径: backend/.env.example
# 功能: 环境变量配置示例
# 版本: v2.0
# 创建日期: 2026-03-25
# 作者: Backend Engineer Agent
#
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. 敏感信息必须通过环境变量设置，不要提交到版本控制
#
# 安全约束:
# - 生产环境必须设置安全的JWT密钥
# - 数据库密码、Redis密码等敏感信息必须修改
# - 设备参数范围必须符合硬件安全规范

# ==================== 应用配置 ====================

# 应用名称
APP_NAME=CAUC-SEP

# 应用版本
APP_VERSION=0.4.0

# 运行环境: development | staging | production
APP_ENV=development

# 调试模式（生产环境必须为false）
DEBUG=false

# 服务器地址
HOST=127.0.0.1

# 服务器端口
PORT=8000

# ==================== 数据库配置 ====================

# 数据库URL（SQLite）
DATABASE_URL=sqlite:///experiments.db

# 数据库连接池大小
DATABASE_POOL_SIZE=5

# 数据库最大溢出连接数
DATABASE_MAX_OVERFLOW=10

# 是否打印SQL语句（生产环境必须为false）
DATABASE_ECHO=false

# ==================== Redis 配置 ====================

# Redis主机地址
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis数据库索引
REDIS_DB=0

# Redis密码（生产环境必须设置）
# REDIS_PASSWORD=your_redis_password_here

# Redis最大连接数
REDIS_MAX_CONNECTIONS=10

# Redis Socket超时时间（秒）
REDIS_SOCKET_TIMEOUT=5

# Redis连接超时时间（秒）
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ==================== 设备配置 - 步进电机 ====================

# 设备ID
MOTOR_DEVICE_ID=stepper_01

# 串口号
MOTOR_PORT=COM3

# Modbus从站ID（范围: 1-247）
MOTOR_SLAVE_ID=1

# 波特率
MOTOR_BAUDRATE=115200

# 校验位: N-无校验, E-偶校验, O-奇校验, M-标记
MOTOR_PARITY=N

# 停止位: 1 或 2
MOTOR_STOPBITS=1

# 数据位: 5-9
MOTOR_BYTESIZE=8

# 通信超时时间（秒）
MOTOR_TIMEOUT=1.0

# 每毫米步数
MOTOR_STEPS_PER_MM=1600

# 正向软件限位（毫米）
MOTOR_POSITIVE_LIMIT=50.0

# 负向软件限位（毫米）
MOTOR_NEGATIVE_LIMIT=-50.0

# 是否启用仿真模式
MOTOR_SIMULATION=true

# 步进电机参数范围约束
MOTOR_SPEED_MIN=100
MOTOR_SPEED_MAX=5000
MOTOR_SPEED_DEFAULT=500
MOTOR_ACCELERATION_MIN=10
MOTOR_ACCELERATION_MAX=10000
MOTOR_ACCELERATION_DEFAULT=100
MOTOR_POSITION_MIN=-1000000
MOTOR_POSITION_MAX=1000000

# ==================== 设备配置 - 电磁铁 ====================

# 设备ID
ELECTROMAGNET_DEVICE_ID=electromagnet_01

# 串口号
ELECTROMAGNET_PORT=COM4

# 波特率
ELECTROMAGNET_BAUDRATE=9600

# 校验位
ELECTROMAGNET_PARITY=N

# 停止位
ELECTROMAGNET_STOPBITS=1

# 数据位
ELECTROMAGNET_BYTESIZE=8

# 通信超时时间（秒）
ELECTROMAGNET_TIMEOUT=1.0

# 最大电流（安培）
ELECTROMAGNET_MAX_CURRENT=10.0

# 是否启用仿真模式
ELECTROMAGNET_SIMULATION=true

# 电磁铁参数范围约束
ELECTROMAGNET_CURRENT_MIN=0.0
ELECTROMAGNET_CURRENT_MAX=10.0
ELECTROMAGNET_CURRENT_DEFAULT=5.0

# ==================== 设备配置 - 温控器 ====================

# 设备ID
TEMPERATURE_DEVICE_ID=temp_controller_01

# 串口号
TEMPERATURE_PORT=COM5

# 波特率
TEMPERATURE_BAUDRATE=9600

# Modbus从站ID
TEMPERATURE_SLAVE_ID=1

# 是否启用仿真模式
TEMPERATURE_SIMULATION=true

# PID参数
TEMPERATURE_PID_KP=1.0
TEMPERATURE_PID_KI=0.1
TEMPERATURE_PID_KD=0.01

# 温度范围（摄氏度）
TEMPERATURE_MAX_TEMP=400.0
TEMPERATURE_MIN_TEMP=-50.0

# 温控器参数范围约束
TEMPERATURE_TARGET_MIN=-50.0
TEMPERATURE_TARGET_MAX=400.0
TEMPERATURE_TOLERANCE=0.5

# ==================== 设备配置 - 压电控制器 ====================

# 设备ID
PIEZO_DEVICE_ID=piezo_01

# 串口号
PIEZO_PORT=COM6

# 是否启用仿真模式
PIEZO_SIMULATION=true

# 最大电压（伏特）
PIEZO_MAX_VOLTAGE=150.0

# 最大位移（微米）
PIEZO_MAX_DISPLACEMENT=100.0

# 通道数
PIEZO_CHANNELS=3

# 压电控制器参数范围约束
PIEZO_VOLTAGE_MIN=0.0
PIEZO_VOLTAGE_MAX=150.0
PIEZO_VOLTAGE_DEFAULT=0.0

# ==================== 设备配置 - 皮安表 ====================

# 设备ID
AMMETER_DEVICE_ID=picoammeter_01

# 串口号
AMMETER_PORT=COM7

# 是否启用仿真模式
AMMETER_SIMULATION=true

# 采样率（Hz）
AMMETER_SAMPLE_RATE=100.0

# 电流量程: auto 或具体值
AMMETER_CURRENT_RANGE=auto

# 皮安表参数范围约束
AMMETER_CURRENT_MIN=-1e-6
AMMETER_CURRENT_MAX=1e-6

# ==================== 安全配置 ====================

# JWT密钥（生产环境必须设置安全的密钥！）
# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-secure-key

# JWT算法
JWT_ALGORITHM=HS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 密码是否需要大写字母
PASSWORD_REQUIRE_UPPERCASE=true

# 密码是否需要小写字母
PASSWORD_REQUIRE_LOWERCASE=true

# 密码是否需要数字
PASSWORD_REQUIRE_DIGIT=true

# 密码是否需要特殊字符
PASSWORD_REQUIRE_SPECIAL=false

# ==================== CORS 配置 ====================

# 允许的源（多个源用逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否允许携带凭证
CORS_ALLOW_CREDENTIALS=true

# 允许的方法（* 表示所有方法）
CORS_ALLOW_METHODS=*

# 允许的请求头（* 表示所有请求头）
CORS_ALLOW_HEADERS=*

# ==================== 日志配置 ====================

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=logs

# 日志文件最大大小（字节）
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=5

# 是否压缩日志文件
LOG_COMPRESS=true

# 是否使用JSON格式（生产环境建议true）
LOG_JSON_FORMAT=false

# 是否包含时间戳
LOG_INCLUDE_TIMESTAMP=true

# 是否包含调用者信息
LOG_INCLUDE_CALLER=true

# ==================== 缓存配置 ====================

# 默认缓存过期时间（秒）
CACHE_DEFAULT_TTL=300

# 内存缓存最大条目数
CACHE_MAX_MEMORY_ITEMS=1000

# 缓存键前缀
CACHE_KEY_PREFIX=cauc_sep:

# ==================== WebSocket 配置 ====================

# WebSocket心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30

# WebSocket最大连接数
WS_MAX_CONNECTIONS=100

# WebSocket消息队列大小
WS_MESSAGE_QUEUE_SIZE=1000

# ==================== 实验配置 ====================

# 最大并发实验数
EXPERIMENT_MAX_CONCURRENT=5

# 实验数据批量大小
EXPERIMENT_DATA_BATCH_SIZE=1000

# 实验自动保存间隔（秒）
EXPERIMENT_AUTO_SAVE_INTERVAL=60

# ==================== 生产环境配置示例 ====================
# 
# 生产环境必须修改以下配置：
# 1. APP_ENV=production
# 2. DEBUG=false
# 3. JWT_SECRET_KEY=<安全的随机密钥>
# 4. DATABASE_ECHO=false
# 5. LOG_LEVEL=WARNING 或 ERROR
# 6. LOG_JSON_FORMAT=true
# 7. 所有设备的SIMULATION=false（连接真实硬件）
# 8. REDIS_PASSWORD=<安全的Redis密码>
# 9. CORS_ALLOW_ORIGINS=<实际的前端域名>
