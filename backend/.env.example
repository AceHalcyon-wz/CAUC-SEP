# ============================================================================
# CAUC-SEP 环境配置模板
# ============================================================================
# 复制此文件为 .env 并根据实际环境修改配置
# cp .env.example .env
# ============================================================================

# ==================== 应用配置 ====================
APP_NAME=CAUC-SEP
APP_VERSION=0.4.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///experiments.db
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password
REDIS_MAX_CONNECTIONS=10

# ==================== 设备配置 - 步进电机 ====================
MOTOR_DEVICE_ID=stepper_01
MOTOR_PORT=COM3
MOTOR_SLAVE_ID=1
MOTOR_BAUDRATE=115200
MOTOR_STEPS_PER_MM=1600
MOTOR_POSITIVE_LIMIT=50.0
MOTOR_NEGATIVE_LIMIT=-50.0
MOTOR_SIMULATION=true

# ==================== 设备配置 - 电磁铁 ====================
ELECTROMAGNET_DEVICE_ID=electromagnet_01
ELECTROMAGNET_PORT=COM4
ELECTROMAGNET_BAUDRATE=9600
ELECTROMAGNET_MAX_CURRENT=10.0
ELECTROMAGNET_SIMULATION=true

# ==================== 设备配置 - 温控器 ====================
TEMPERATURE_DEVICE_ID=temp_controller_01
TEMPERATURE_PORT=COM5
TEMPERATURE_SLAVE_ID=1
TEMPERATURE_SIMULATION=true
TEMPERATURE_MAX_TEMP=400.0
TEMPERATURE_MIN_TEMP=-50.0

# ==================== 设备配置 - 压电控制器 ====================
PIEZO_DEVICE_ID=piezo_01
PIEZO_PORT=COM6
PIEZO_SIMULATION=true
PIEZO_MAX_VOLTAGE=150.0
PIEZO_MAX_DISPLACEMENT=100.0

# ==================== 设备配置 - 皮安表 ====================
AMMETER_DEVICE_ID=picoammeter_01
AMMETER_PORT=COM7
AMMETER_SIMULATION=true
AMMETER_SAMPLE_RATE=100.0

# ==================== 安全配置 ====================
# 生产环境请使用安全的随机密钥！
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production-use-secure-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================
# 多个源用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON_FORMAT=false

# ==================== 缓存配置 ====================
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=cauc_sep:

# ==================== WebSocket 配置 ====================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# ==================== 实验配置 ====================
EXPERIMENT_MAX_CONCURRENT=5
EXPERIMENT_AUTO_SAVE_INTERVAL=60
