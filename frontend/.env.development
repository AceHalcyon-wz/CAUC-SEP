# ==================== CAUC-SEP 前端开发环境配置 ====================
#
# 文件名: .env.development
# 路径: frontend/.env.development
# 功能: 前端开发环境专用配置
# 版本: v1.0
# 创建日期: 2026-03-25
# 作者: DevOps Engineer Agent
#
# 使用说明:
# 1. 开发环境自动加载此文件
# 2. 优先级高于 .env
# ============================================================================

# ==================== 应用配置 ====================

VITE_APP_NAME=CAUC-SEP (Dev)
VITE_APP_VERSION=4.0.0
VITE_APP_TITLE=CAUC-SEP 自旋电子器件实验平台 - 开发环境
VITE_APP_DESCRIPTION=多设备集成自旋电子器件实验平台

# ==================== API 配置 ====================

# 开发环境使用 Vite 代理
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_API_TIMEOUT=30000

# ==================== 功能开关 ====================

VITE_DEBUG=true
VITE_DEV_TOOLS=true
VITE_ENABLE_PERFORMANCE_MONITOR=true
VITE_ENABLE_ERROR_REPORT=false

# ==================== UI 配置 ====================

VITE_THEME=light
VITE_LANGUAGE=zh-CN
VITE_PAGE_SIZE=20

# ==================== WebSocket 配置 ====================

VITE_WS_RECONNECT_INTERVAL=3000
VITE_WS_MAX_RECONNECT_TIMES=5
VITE_WS_HEARTBEAT_INTERVAL=30000

# ==================== 数据配置 ====================

VITE_DATA_REFRESH_INTERVAL=100
VITE_CHART_MAX_POINTS=1000
VITE_EXPERIMENT_AUTO_SAVE=60
