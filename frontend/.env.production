# ==================== CAUC-SEP 前端生产环境配置 ====================
#
# 文件名: .env.production
# 路径: frontend/.env.production
# 功能: 前端生产环境专用配置
# 版本: v1.0
# 创建日期: 2026-03-25
# 作者: DevOps Engineer Agent
#
# 使用说明:
# 1. 生产构建时自动加载此文件
# 2. 优先级高于 .env
# 3. 敏感配置不要在此文件中设置
# ============================================================================

# ==================== 应用配置 ====================

VITE_APP_NAME=CAUC-SEP
VITE_APP_VERSION=4.0.0
VITE_APP_TITLE=CAUC-SEP 自旋电子器件实验平台
VITE_APP_DESCRIPTION=多设备集成自旋电子器件实验平台

# ==================== API 配置 ====================

# 生产环境使用实际 API 地址
# Electron 桌面应用使用本地地址
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_API_TIMEOUT=30000

# ==================== 功能开关 ====================

VITE_DEBUG=false
VITE_DEV_TOOLS=false
VITE_ENABLE_PERFORMANCE_MONITOR=false
VITE_ENABLE_ERROR_REPORT=true

# ==================== UI 配置 ====================

VITE_THEME=light
VITE_LANGUAGE=zh-CN
VITE_PAGE_SIZE=20

# ==================== WebSocket 配置 ====================

VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_TIMES=10
VITE_WS_HEARTBEAT_INTERVAL=30000

# ==================== 数据配置 ====================

VITE_DATA_REFRESH_INTERVAL=200
VITE_CHART_MAX_POINTS=2000
VITE_EXPERIMENT_AUTO_SAVE=60
