{
  "name": "cauc-sep-frontend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,css,scss,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.js",
    "test:e2e:settings": "playwright test tests/e2e/settings.spec.js",
    "test:e2e:cross-browser": "playwright test tests/e2e/cross-browser.spec.js",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e",
    "generate:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/generated.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@element-plus/icons-vue": "2.3.1",
    "ant-design-vue": "^4.2.6",
    "axios": "1.8.3",
    "echarts": "5.6.0",
    "element-plus": "^2.13.5",
    "html2canvas": "1.4.1",
    "marked": "^17.0.4",
    "msgpack-lite": "0.1.26",
    "pinia": "3.0.2",
    "vue": "3.5.13",
    "vue-echarts": "7.0.3",
    "vue-i18n": "11.1.3",
    "vue-router": "4.5.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "@vitejs/plugin-vue": "5.2.3",
    "@vitest/coverage-v8": "3.0.9",
    "@vitest/ui": "3.0.9",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.23.0",
    "eslint-plugin-vue": "10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "openapi-typescript": "7.6.1",
    "playwright-electron": "^0.5.0",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "5.14.0",
    "sass": "1.86.0",
    "terser": "5.39.0",
    "typescript": "5.8.2",
    "vite": "6.2.2",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "3.0.9",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "2.2.8"
  }
}
